{
  "name": "vacation-app-monorepo",
  "version": "1.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:clear": "./scripts/dev.sh --clear",
    "dev:clear-all": "./scripts/dev.sh --clear-all",
    "dev:backend": "./scripts/dev.sh --backend-only",
    "dev:mobile": "./scripts/dev.sh --mobile-only",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v && docker compose -f infra/docker-compose.yml up -d",
    "api": "cd apps/api && uv run --no-sync python manage.py",
    "api:migrate": "cd apps/api && uv run --no-sync python manage.py migrate",
    "test:api": "cd apps/api && uv run --no-sync pytest",
    "test:api:fresh": "cd apps/api && uv run --no-sync pytest --create-db",
    "mobile": "pnpm --filter mobile",
    "start": "pnpm --filter mobile start",
    "ios": "pnpm --filter mobile ios",
    "android": "pnpm --filter mobile android",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "i18n:check": "pnpm --filter mobile i18n:check",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.10",
      "uuid": "^11.1.1"
    }
  }
}
