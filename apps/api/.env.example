# Copy to .env for local development. Never commit .env.
# In production these are injected as Kamal secrets, not read from a file.

# Django
SECRET_KEY=dev-only-change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — points at the docker-compose Postgres (infra/docker-compose.yml).
DATABASE_URL=postgres://vacation:vacation@localhost:5432/vacation

# CORS — origins allowed to call the API. In DEBUG all origins are allowed,
# so this matters only in production (the deployed app / web origin).
CORS_ALLOWED_ORIGINS=
